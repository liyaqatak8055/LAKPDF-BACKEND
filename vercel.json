{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://lakpdf-backend-1.onrender.com/api/$1" },
    { "source": "/pdf-to-jpg", "destination": "/pdf-to-img" },
    { "source": "/jpg-to-pdf", "destination": "/img-to-pdf" },
    { "source": "/merge-pdf", "destination": "/merge" },
    { "source": "/split-pdf", "destination": "/split" },
    { "source": "/scan-to-pdf", "destination": "/scan-pdf" },
    { "source": "/add-page-numbers-to-pdf", "destination": "/page-number" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    }
  ]
}
