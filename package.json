{
  "name": "copy-of-lak-pdf-1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "server:restart": "sh -c 'lsof -ti tcp:${PORT:-8787} | xargs kill 2>/dev/null || true; node server/index.js'",
    "server:cluster": "NODE_ENV=production node server/cluster.js",
    "check:env": "node server/checkEnv.js",
    "check:env:prod": "NODE_ENV=production node server/checkEnv.js",
    "dev:full": "sh -c 'npm run server & npm run dev'",
    "load:health": "autocannon -c 100 -d 30 http://localhost:8787/api/health",
    "load:ai": "autocannon -c 2 -d 20 -t 60 -m POST -H 'content-type: application/json' -b '{\"prompt\":\"Load test ping\"}' --renderStatusCodes http://localhost:8787/api/ai/ask",
    "security:audit": "npm audit --omit=dev",
    "security:audit:json": "npm audit --omit=dev --json",
    "security:migrate-otp": "node scripts/migrate-otp-hashes.mjs",
    "test:cross-browser": "playwright test tests/cross-browser-blank-page.spec.ts",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "build": "npm run sitemap:generate && vite build && node -e \"const fs=require('fs');const path=require('path');const src=path.join('public','.htaccess');const dest=path.join('dist','.htaccess');if(fs.existsSync(src)){fs.copyFileSync(src,dest);}\"",
    "start": "NODE_ENV=production node server/cluster.js",
    "start:single": "NODE_ENV=production node server/index.js",
    "start:prod": "npm run check:env:prod && npm run start",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "7.8.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fabric": "^7.2.0",
    "file-saver": "2.0.5",
    "google-auth-library": "^9.15.1",
    "html2canvas": "1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.0",
    "jszip": "3.10.1",
    "lucide-react": "^0.561.0",
    "mammoth": "^1.11.0",
    "mongodb": "^7.1.0",
    "mongoose": "^9.2.3",
    "nanoid": "^5.1.6",
    "nodemailer": "^8.0.1",
    "openai": "^4.79.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "pptxgenjs": "3.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.10.1",
    "tesseract.js": "5.0.5",
    "uuid": "^13.0.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.23",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "terser": "^5.46.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
