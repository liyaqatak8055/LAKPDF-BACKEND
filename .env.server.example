NODE_ENV=development
PORT=8787
# WEB_CONCURRENCY=1
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_server_key
GROQ_API_KEY=your_groq_api_key
DEEPINFRA_API_KEY=your_deepinfra_api_key
GOOGLE_CLIENT_ID=your_google_oauth_client_id
MONGODB_URI=your_mongodb_atlas_uri
MONGODB_DB_NAME=lakpdf
JWT_SECRET=replace_with_strong_secret
ADMIN_API_KEY=replace_with_admin_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ACCESS_COOKIE_MAX_AGE_MS=900000
REFRESH_COOKIE_MAX_AGE_MS=2592000000
REFRESH_SESSION_LIMIT=5
FREE_SUMMARY_LIMIT_PER_DAY=3
SUMMARY_WORD_HARD_LIMIT=120
AUTH_FAIL_WINDOW_MS=900000
AUTH_FAIL_MAX_PER_IP=20
AUTH_FAIL_MAX_PER_EMAIL_IP=6
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM=noreply@lakpdf.com
# For local testing only
# RETURN_OTP_IN_API=true
GEMINI_API_KEY=your_gemini_server_key
# Optional: comma-separated frontend origins for strict CORS
# ALLOWED_ORIGINS=https://lakpdf.com,https://www.lakpdf.com
# Optional: extra origins (e.g. staging apps). Localhost dev origins are auto-allowed.
# EXTRA_ALLOWED_ORIGINS=https://staging.lakpdf.com,https://preview.example.com
# Rate limiting / payload guards
# RATE_WINDOW_MS=60000
# ASK_RATE_LIMIT=120
# PROVIDER_RATE_LIMIT=90
# MAX_PROMPT_LENGTH=12000
# AI cost protection
# MAX_PROMPT_CHARS=8000
# ASK_MAX_OUTPUT_TOKENS=1000
# AI_MAX_OUTPUT_TOKENS=1200
# DAILY_AI_REQUEST_CAP=600
# DAILY_AI_TOKEN_CAP=200000
# AI_MAX_CONCURRENT_REQUESTS=8
# AI_MAX_QUEUE_SIZE=200
# AI_TASK_TIMEOUT_MS=45000
# Optional model overrides
# AI_PRIMARY_MODEL=openai/gpt-4o-mini
# AI_SECONDARY_MODEL=anthropic/claude-3-haiku
# AI_GEMINI_MODEL=gemini-1.5-flash
